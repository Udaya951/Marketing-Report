  try { previousRenderChartsForSWVA(); }
  finally { dashboardData.ga4 = currentGA; }
  if (!window.Chart) return;
  const weeks = ['Sep 21–27', 'Sep 28–Oct 4'], g = dashboardData.searchConsole;
  for (const id of ['trafficBox', 'searchBox', 'positionBox', 'ctrBox']) showCanvas(id);
  chart('trafficChart', 'bar', weeks, [{label: 'Organic sessions', data: [currentGA.previous.organicSessions, currentGA.organicSessions], backgroundColor: '#087e82', borderRadius: 5}]);
  chart('searchChart', 'bar', weeks, [
    {label: 'Clicks', data: [g.previousSummary.clicks, g.summary.clicks], backgroundColor: '#087e82', yAxisID: 'y'},
    {label: 'Impressions', data: [g.previousSummary.impressions, g.summary.impressions], backgroundColor: '#3266a8', yAxisID: 'y1'}
  ], {secondAxis: true});
  chart('positionChart', 'bar', weeks, [{label: 'Average position', data: [g.previousSummary.position, g.summary.position], backgroundColor: '#3266a8'}], {reverse: true});
  chart('ctrChart', 'bar', weeks, [{label: 'CTR', data: [rate(g.previousSummary.clicks, g.previousSummary.impressions) * 100, rate(g.summary.clicks, g.summary.impressions) * 100], backgroundColor: '#087e82'}], {percent: true});
};
const previousCsvExportForSWVA = csvExport;
csvExport = function () {
  if (!swvaSelected()) return previousCsvExportForSWVA();
  const headers = ['Practice', 'Keyword', 'Location', 'Previous Rank', 'Current Rank', 'Change', 'Improvement', 'Search Volume', 'Category', 'Priority', 'URL', 'SEO Status'];
  const quote = v => `"${String(v ?? '').replace(/"/g, '""')}"`;
  const rows = [headers, ...filteredRankings().map(r => ['Southwest Virginia Cardiology', r.keyword, r.location, r.previousRank, r.currentRank, rankChange(r), r.improvement, r.searchVolume, r.category, r.priority, r.url, rankStatus(r)])];
  const csv = rows.map(row => row.map(quote).join(',')).join('\r\n');
  const url = URL.createObjectURL(new Blob(['\ufeff' + csv], {type: 'text/csv;charset=utf-8'}));
  const a = document.createElement('a'); a.href = url; a.download = 'southwest-virginia-cardiology-keyword-rankings-2026-10-05.csv'; a.click();
  setTimeout(() => URL.revokeObjectURL(url), 1000); $('exportMenu').hidden = true;
};
const previousRenderForSWVA = render;
render = function () {
  previousRenderForSWVA();
  if (!swvaSelected()) return;
  const p = swvaPeriod(), gp = state.view === 'previous' ? dashboardData.meta.previousGSCPeriod : dashboardData.meta.gscPeriod;
  $('lastUpdated').textContent = 'Source exports · Oct 5, 2026';
  $('periodLabel').textContent = `GA4: ${period(p)} · GSC: ${period(gp)}`;
  $('comparisonLabel').textContent = 'Current Sep 28–Oct 4 vs previous Sep 21–27, 2026';
  $('gaPeriod').textContent = `${period(p)} · GA4 property: Southwest Virginia Cardiology`;
  $('gscPeriod').textContent = `${period(gp)} · Web search`;
  $('rankingPeriodLabel').textContent = 'Sep 27 → Oct 5, 2026 · column headings; row timestamps older';
  $('leadPeriodLabel').textContent = `Full report: ${fmt(dashboardData.organicLeads.fullReportRows)} rows · selected week: ${period(p)}`;
  $('pagePeriodLabel').textContent = `GSC ${period(gp)} · GA4 landing page export`;
  $('leadScopeNote').textContent = `The Southwest Virginia lead workbook contains ${fmt(dashboardData.organicLeads.fullReportRows)} historical rows. Its firstapptdate column has ${fmt(dashboardData.organicLeads.weeklyTotal)} rows in Sep 28–Oct 4 and ${fmt(dashboardData.organicLeads.previousWeeklyTotal)} in Sep 21–27. One row is self-reported Practice Website and one Online Search; those labels do not establish organic attribution. A week-over-week lead percentage cannot be calculated when both weeks have zero dated rows.`;
  document.querySelector('#leads .section-heading h2').textContent = 'Lead Performance · Attribution Unverified';
  document.querySelector('#leads #sourceLeadsChart').closest('.panel').querySelector('.panel-head p').textContent = 'Full supplied workbook · self-reported sources';
  $('quickInsight').innerHTML = `<strong>Southwest Virginia Cardiology</strong> · Organic sessions held at ${fmt(dashboardData.ga4.organicSessions)} in both weeks. The supplied lead workbook contains ${fmt(dashboardData.organicLeads.fullReportRows)} historical rows and no dated rows in either selected week.`;
};

let toastTimer;function toast(message){$('toast').textContent=message;$('toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').classList.remove('show'),4500)}
$('practiceSelect').addEventListener('change',e=>{state.practice=e.target.value;state.keywordSearch='';state.querySearch='';state.status='all';$('keywordSearch').value='';$('querySearch').value='';$('statusFilter').value='all';render()});
$('rangeSelect').addEventListener('change',e=>{state.view=e.target.value;render()});
$('keywordSearch').addEventListener('input',e=>{state.keywordSearch=e.target.value.trim().toLowerCase();renderRankings()});
$('querySearch').addEventListener('input',e=>{state.querySearch=e.target.value.trim().toLowerCase();renderQueries()});
$('statusFilter').addEventListener('change',e=>{state.status=e.target.value;renderRankings()});
$('rankSort').addEventListener('change',e=>{state.rankSort=e.target.value;renderRankings()});
$('pageSort').addEventListener('change',e=>{state.pageSort=e.target.value;renderPages()});
$('monthlySort').addEventListener('change',e=>{state.monthlySort=e.target.value;renderMonthly()});
try{if(localStorage.getItem('alignedcardio-theme')==='dark')document.body.classList.add('dark')}catch(_){}
$('themeButton').addEventListener('click',()=>{document.body.classList.toggle('dark');const dark=document.body.classList.contains('dark');try{localStorage.setItem('alignedcardio-theme',dark?'dark':'light')}catch(_){}$('themeButton').setAttribute('aria-label',`Switch to ${dark?'light':'dark'} mode`);renderCharts()});
function closeMenu(){$('sidebar').classList.remove('open');$('scrim').hidden=true;$('menuButton').setAttribute('aria-expanded','false')}
$('menuButton').addEventListener('click',()=>{const open=$('sidebar').classList.toggle('open');$('scrim').hidden=!open;$('menuButton').setAttribute('aria-expanded',String(open))});$('scrim').addEventListener('click',closeMenu);
document.querySelectorAll('.sidebar nav a').forEach(a=>a.addEventListener('click',()=>{document.querySelectorAll('.sidebar nav a').forEach(x=>x.classList.remove('active'));a.classList.add('active');closeMenu()}));
$('printHeader').addEventListener('click',()=>{$('exportMenu').hidden=!$('exportMenu').hidden});$('exportCsv').addEventListener('click',csvExport);$('printReport').addEventListener('click',()=>{$('exportMenu').hidden=true;window.print()});$('downloadPdf').addEventListener('click',()=>{$('exportMenu').hidden=true;toast('Choose “Save as PDF” in the print dialog.');setTimeout(()=>window.print(),350)});document.addEventListener('click',e=>{if(!$('exportMenu').contains(e.target)&&e.target!==$('printHeader'))$('exportMenu').hidden=true});render();

  </script>
