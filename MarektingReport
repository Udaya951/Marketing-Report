<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102d45">
  <meta name="description" content="AlignedCardio digital marketing performance dashboard for participating cardiology practices.">
  <title>AlignedCardio | SEO &amp; Inbound Marketing Performance</title>

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='14'%20fill='%23102d45'/%3E%3Cpath%20d='M8%2034h12l6-12%2010%2024%207-12h13'%20fill='none'%20stroke='%2377d2c9'%20stroke-width='5'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E">
  <style>
/* Variables */
:root {
  --navy: #102d45;
  --navy2: #173f5b;
  --teal: #087e82;
  --mint: #dff4ef;
  --blue: #3266a8;
  --bg: #f5f8fa;
  --panel: #fff;
  --ink: #183247;
  --muted: #64778a;
  --line: #e0e9ef;
  --good: #07866d;
  --bad: #bd5c50;
  --amber: #a56923;
  --shadow: 0 12px 36px rgba(18, 47, 70, 0.045);
  --radius: 16px;
  --sidebar: 242px;

  font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
  color-scheme: light;
}

body.dark {
  --navy: #0c1c2b;
  --navy2: #16364c;
  --teal: #58c9c1;
  --mint: #193e3e;
  --blue: #7bb4f0;
  --bg: #0d1925;
  --panel: #172838;
  --ink: #e8f3f7;
  --muted: #a2b6c5;
  --line: #2d4353;
  --good: #60d6b2;
  --bad: #f28b80;
  --amber: #e6b775;
  --shadow: none;

  color-scheme: dark;
}

/* Reset */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 94px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.5;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

h1,
h2,
h3,
h4,
p {
  margin: 0;
}

h1 {
  font-size: clamp(1.7rem, 2.5vw, 2.35rem);
  line-height: 1.2;
  letter-spacing: -0.035em;
}

h2 {
  font-size: 1.43rem;
  letter-spacing: -0.025em;
}

h3 {
  font-size: 1rem;
}

h4 {
  font-size: 0.9rem;
}

small {
  font-size: 0.76rem;
}

input,
select,
button {
  min-height: 40px;
}

input,
select {
  background: var(--panel);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 9px 12px;
  max-width: 100%;
}

:focus-visible {
  outline: 3px solid #5ccfc3;
  outline-offset: 2px;
}

[hidden] {
  display: none !important;
}

.skip {
  position: absolute;
  left: -9999px;
  z-index: 100;
}

.skip:focus {
  left: 12px;
  top: 12px;
  background: #fff;
  padding: 10px;
}

/* Layout */
.app {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: var(--sidebar);
  position: fixed;
  inset: 0 auto 0 0;
  background: var(--navy);
  color: #d9e7ef;
  padding: 26px 16px;
  display: flex;
  flex-direction: column;
  z-index: 30;
}

.main-wrap {
  margin-left: var(--sidebar);
  width: calc(100% - var(--sidebar));
  min-width: 0;
}

main {
  padding: 32px clamp(20px, 3vw, 48px) 24px;
  max-width: 1700px;
  margin: auto;
}

.dashboard-section {
  margin-top: 54px;
  scroll-margin-top: 100px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin: 0 0 17px;
}

.section-heading .muted,
.source-label {
  color: var(--muted);
  font-size: 0.82rem;
}

.eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  font-weight: 800;
  color: var(--teal);
}

.section-heading h2 {
  margin-top: 3px;
}

.page-intro {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 22px;
  margin-bottom: 25px;
}

.page-intro h1 {
  margin-top: 10px;
}

.page-intro p {
  color: var(--muted);
  margin-top: 8px;
  font-weight: 600;
}

.demo-tag {
  letter-spacing: 0.05em;
  background: var(--mint);
  color: var(--teal);
  border-radius: 4px;
  padding: 4px 6px;
  margin-left: 8px;
}

.filters {
  display: flex;
  gap: 10px;
}

.filters label,
.custom-range label {
  display: grid;
  gap: 5px;
  color: var(--muted);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  font-weight: 750;
}

.filters select {
  min-width: 205px;
  letter-spacing: 0;
  font-size: 0.87rem;
  font-weight: 600;
}

.custom-range {
  display: flex;
  align-items: end;
  gap: 10px;
  margin: -10px 0 20px;
  flex-wrap: wrap;
}

.custom-range #dateError {
  color: var(--bad);
  font-size: 0.86rem;
}

/* Header */
.topbar {
  height: 76px;
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--panel);
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 clamp(20px, 3vw, 48px);
  gap: 12px;
}

.header-title {
  display: flex;
  flex-direction: column;
  line-height: 1.35;
}

.header-title strong {
  font-size: 0.94rem;
}

.header-title span {
  font-size: 0.77rem;
  color: var(--muted);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.week-pill {
  border: 1px solid var(--line);
  border-radius: 40px;
  padding: 8px 13px;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--teal);
  white-space: nowrap;
}

.button {
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 9px 15px;
  font-size: 0.85rem;
  font-weight: 700;
  background: var(--panel);
  color: var(--ink);
}

.button:hover,
.icon-button:hover {
  border-color: var(--teal);
  color: var(--teal);
}

.button.primary {
  background: var(--navy2);
  border-color: var(--navy2);
  color: #fff;
}

.icon-button {
  width: 40px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--panel);
  color: var(--ink);
  font-size: 1.1rem;
}

.menu {
  display: none;
}

/* Sidebar */
.brand {
  display: flex;
  gap: 11px;
  align-items: center;
  color: white;
  font-size: 1.15rem;
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: -0.03em;
  margin: 4px 7px 37px;
}

.brand-accent {
  color: #8fe5dc;
}

.brand small {
  display: block;
  color: #9ab7c7;
  font-size: 0.55rem;
  letter-spacing: 0.13em;
  margin-top: 6px;
}

.mark {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 9px;
  background: #27637a;
  color: #a6f1e4;
  font-size: 2rem;
  font-weight: 400;
}

.sidebar nav {
  display: grid;
  gap: 5px;
}

.sidebar nav a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 13px;
  border-radius: 9px;
  font-size: 0.84rem;
  font-weight: 600;
  min-height: 42px;
}

.sidebar nav a:hover,
.sidebar nav a.active {
  background: #224c62;
  color: #fff;
}

.sidebar nav a:first-letter {
  color: #96d8d8;
}

.side-bottom {
  margin: auto 9px 7px;
  border-top: 1px solid #34566b;
  padding-top: 18px;
  color: #b4cbd4;
  font-size: 0.69rem;
  letter-spacing: 0.1em;
  font-weight: 700;
}

.side-bottom small {
  letter-spacing: 0;
  color: #8cabb9;
  font-weight: 400;
}

.demo-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #70d5bb;
  border-radius: 50%;
  margin-right: 5px;
}

/* KPI Cards */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.kpi,
.mini,
.panel,
.tech-card,
.insight-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.kpi {
  padding: 21px 23px;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.kpi:hover,
.panel:hover {
  box-shadow: 0 15px 40px rgba(18, 47, 70, 0.08);
}

.kpi:hover {
  transform: translateY(-2px);
}

.kpi::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24px;
  bottom: 24px;
  width: 3px;
  background: var(--teal);
  border-radius: 2px;
}

.metric-label {
  color: var(--muted);
  font-size: 0.84rem;
  font-weight: 650;
}

.metric-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 5px;
  margin: 8px 0 4px;
}

.metric-value {
  font-size: clamp(1.6rem, 2.3vw, 2.15rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.15;
}

.spark {
  width: 74px;
  height: 30px;
  flex: none;
}

.comparison {
  font-size: 0.76rem;
  color: var(--muted);
}

.delta {
  font-weight: 800;
}

.delta.good {
  color: var(--good);
}

.delta.bad {
  color: var(--bad);
}

.delta.neutral {
  color: var(--muted);
}

.insight-strip {
  margin-top: 15px;
  border: 1px solid var(--line);
  border-left: 3px solid var(--teal);
  background: var(--panel);
  border-radius: 10px;
  padding: 12px 17px;
  color: var(--muted);
  font-size: 0.88rem;
}

.insight-strip strong {
  color: var(--ink);
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 15px;
}

.mini-grid.five {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.mini {
  padding: 18px;
}

.mini strong {
  display: block;
  font-size: 1.55rem;
  letter-spacing: -0.035em;
  margin: 5px 0 2px;
}

.mini .metric-label {
  font-size: 0.76rem;
}

.mini small {
  color: var(--muted);
}

/* Charts */
.chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
}

.chart-grid.two {
  margin-bottom: 15px;
}

.panel {
  padding: 20px 22px;
  min-width: 0;
  margin-bottom: 15px;
}

.chart-grid .panel {
  margin-bottom: 0;
}

.chart-grid .wide {
  grid-column: span 2;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 15px;
}

.panel-head p {
  color: var(--muted);
  font-size: 0.81rem;
  margin-top: 2px;
}

.chart-box {
  height: 270px;
  position: relative;
}

.chart-box.short {
  height: 210px;
}

.chart-box canvas {
  max-width: 100%;
  max-height: 100%;
}

.source-label {
  background: var(--mint);
  padding: 5px 10px;
  border-radius: 6px;
  color: var(--teal);
  font-weight: 700;
}

/* Tables */
.table-panel {
  padding-bottom: 4px;
}

.table-scroll {
  overflow: auto;
  max-width: 100%;
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
  font-size: 0.82rem;
}

th {
  background: var(--bg);
  color: var(--muted);
  font-size: 0.7rem;
  letter-spacing: 0.045em;
  text-transform: uppercase;
  font-weight: 800;
}

td,
th {
  padding: 11px 12px;
  border-bottom: 1px solid var(--line);
}

tbody tr:hover {
  background: var(--bg);
}

tbody tr:last-child td {
  border-bottom: 0;
}

td:first-child {
  font-weight: 650;
}

td a {
  color: var(--blue);
}

.table-tools {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.table-tools input {
  min-width: 190px;
}

.table-tools select {
  max-width: 150px;
}

.panel-head.wrap {
  flex-wrap: wrap;
}

.table-panel .panel-head {
  padding-bottom: 5px;
}

.empty {
  color: var(--muted);
  text-align: center;
  padding: 25px;
}

/* Badges */
.badge {
  display: inline-flex;
  border-radius: 5px;
  padding: 3px 7px;
  font-size: 0.72rem;
  font-weight: 700;
  background: var(--bg);
  color: var(--muted);
}

.badge.improved,
.badge.healthy,
.badge.converted {
  background: rgba(20, 164, 125, 0.12);
  color: var(--good);
}

.badge.declined,
.badge.critical {
  background: rgba(205, 91, 76, 0.12);
  color: var(--bad);
}

.badge.new,
.badge.attention {
  background: rgba(212, 150, 58, 0.14);
  color: var(--amber);
}

.badge.stable {
  background: rgba(84, 134, 178, 0.14);
  color: var(--blue);
}

.funnel {
  display: grid;
  gap: 12px;
}

.funnel-row {
  display: grid;
  grid-template-columns: 165px 1fr 50px;
  align-items: center;
  gap: 12px;
  font-size: 0.81rem;
}

.track {
  height: 13px;
  border-radius: 20px;
  background: var(--bg);
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 20px;
  background: linear-gradient(90deg, var(--teal), #81cabe);
}

.funnel-row strong {
  text-align: right;
}

.summary-card h3 {
  margin-bottom: 18px;
}

.summary-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.summary-columns h4 {
  margin-bottom: 10px;
}

.summary-columns ul {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
}

.summary-columns li {
  margin-bottom: 9px;
  font-size: 0.84rem;
}

.tech-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 15px;
}

.tech-card {
  padding: 15px 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.tech-card strong {
  font-size: 1.2rem;
}

.tech-card .metric-label {
  display: block;
  font-size: 0.76rem;
}

.detail-note {
  background: var(--mint);
  padding: 14px;
  border-radius: 9px;
  margin-bottom: 15px;
  color: var(--ink);
}

.insights-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 15px;
}

.insight-card {
  padding: 18px 19px;
}

.insight-card span {
  color: var(--teal);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  font-weight: 800;
}

.insight-card p {
  margin-top: 7px;
  font-weight: 650;
  font-size: 0.88rem;
}

footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.75rem;
  margin-top: 48px;
  padding-top: 22px;
}

.export-menu {
  position: fixed;
  right: 28px;
  top: 64px;
  z-index: 50;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 11px;
  box-shadow: 0 18px 40px #0002;
  padding: 7px;
  min-width: 178px;
}

.export-menu button {
  display: block;
  width: 100%;
  text-align: left;
  background: transparent;
  color: var(--ink);
  border: 0;
  border-radius: 6px;
  padding: 9px;
}

.export-menu button:hover {
  background: var(--bg);
}

.toast {
  position: fixed;
  right: 20px;
  bottom: 20px;
  background: var(--navy);
  color: #fff;
  border-radius: 8px;
  padding: 12px 16px;
  z-index: 60;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
}

.toast.show {
  opacity: 1;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .mini-grid.five {
    grid-template-columns: repeat(3, 1fr);
  }

  .filters {
    flex-wrap: wrap;
  }

  .page-intro {
    align-items: start;
  }
}

@media (max-width: 950px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.25s;
  }

  .sidebar.open {
    transform: none;
  }

  .main-wrap {
    margin-left: 0;
    width: 100%;
  }

  .menu {
    display: block;
  }

  .mobile-scrim:not([hidden]) {
    position: fixed;
    inset: 0;
    background: #06182491;
    z-index: 25;
  }

  .page-intro {
    flex-wrap: wrap;
  }

  .filters {
    width: 100%;
  }

  .filters label {
    flex: 1;
  }

  .filters select {
    width: 100%;
  }
}

@media (max-width: 700px) {
  main {
    padding: 23px 15px;
  }

  .topbar {
    height: 66px;
    padding: 0 14px;
  }

  .header-title strong {
    font-size: 0.79rem;
    max-width: 190px;
  }

  .week-pill {
    display: none;
  }

  .export-button {
    font-size: 0.73rem;
    padding: 7px;
    min-height: 36px;
  }

  .kpi-grid,
  .chart-grid,
  .chart-grid.two,
  .mini-grid,
  .mini-grid.five,
  .tech-grid,
  .insights-grid {
    grid-template-columns: 1fr 1fr;
  }

  .chart-grid .wide {
    grid-column: span 2;
  }

  .filters {
    flex-direction: column;
  }

  .section-heading {
    align-items: start;
    flex-wrap: wrap;
  }

  .panel {
    padding: 17px;
  }

  .summary-columns {
    grid-template-columns: 1fr;
  }

  .chart-box {
    height: 240px;
  }
}

@media (max-width: 480px) {
  .kpi-grid,
  .chart-grid,
  .chart-grid.two,
  .mini-grid,
  .mini-grid.five,
  .tech-grid,
  .insights-grid {
    grid-template-columns: 1fr;
  }

  .chart-grid .wide {
    grid-column: span 1;
  }

  .kpi {
    padding: 17px 21px;
  }

  .funnel-row {
    grid-template-columns: 110px 1fr 32px;
  }

  .header-title span {
    font-size: 0.66rem;
  }

  footer {
    flex-direction: column;
  }
}

/* Dark Mode */
body.dark .sidebar {
  background: #071522;
}

body.dark .sidebar nav a.active,
body.dark .sidebar nav a:hover {
  background: #1a4052;
}

body.dark .button.primary {
  background: #237783;
  border-color: #237783;
}

body.dark .toast {
  background: #245263;
}

/* Print Styles */
@media print {
  @page {
    size: A4;
    margin: 12mm;
  }

  body {
    background: #fff !important;
    color: #172d3d !important;
    font-size: 10pt;
  }

  .sidebar,
  .topbar,
  .filters,
  .custom-range,
  .table-tools,
  .button,
  .icon-button,
  .export-menu,
  .toast,
  .mobile-scrim {
    display: none !important;
  }

  .main-wrap {
    width: 100%;
    margin: 0;
  }

  main {
    padding: 0;
    max-width: none;
  }

  .page-intro {
    margin-bottom: 12px;
  }

  .dashboard-section {
    margin-top: 25px;
    break-before: auto;
  }

  .panel,
  .kpi,
  .mini,
  .tech-card,
  .insight-card {
    box-shadow: none;
    break-inside: avoid;
    border: 1px solid #ddd;
  }

  .chart-grid {
    display: block;
  }

  .chart-grid .panel {
    margin-bottom: 12px;
  }

  .chart-box {
    height: 190px;
  }

  .table-scroll {
    overflow: visible;
  }

  table {
    white-space: normal;
    font-size: 8pt;
